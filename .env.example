# Supabase Configuration
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_KEY=your_supabase_anon_key

# OpenRouter API Configuration (optional - uses mock if not set)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Mock AI Service (optional - set to "true" to force mock mode even with API key)
# Useful for testing without consuming API credits
MOCK_AI_SERVICE=false

OPENROUTER_API_KEY=""
