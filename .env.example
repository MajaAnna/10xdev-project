# Supabase Configuration
# These are exposed to the client (browser)
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# This is used for server-side operations and should be kept secret
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter API Configuration (optional - uses mock if not set)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Mock AI Service (optional - set to "true" to force mock mode even with API key)
# Useful for testing without consuming API credits
MOCK_AI_SERVICE=false

OPENROUTER_API_KEY=""
